FROM injistack/inji-certify-with-plugins:1.0.0-alpha.1@sha256:1579b2449f1a7213fe25de1f6a1509b5636f1fedf0d7f5c4cfd07b9f0fc5b346
USER root
COPY certify-service.jar /home/inji/certify-service.jar
RUN rm /home/inji/additional_jars/mock-certify-plugin.jar \
       /home/inji/additional_jars/mosip-identity-certify-plugin.jar \
       /home/inji/additional_jars/sunbird-rc-certify-integration-impl.jar \
    && chown inji:inji /home/inji/certify-service.jar
LABEL org.opencontainers.image.description="Pinned native Certify source with explicitly selected and tested Final-profile fixes"
USER 1001
