+package io.mosip.certify.services;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nimbusds.jose.JWSAlgorithm;
+import com.nimbusds.jose.JWSHeader;
+import com.nimbusds.jose.JOSEObjectType;
+import com.nimbusds.jose.crypto.ECDSASigner;
+import com.nimbusds.jose.crypto.ECDSAVerifier;
+import com.nimbusds.jose.jwk.Curve;
+import com.nimbusds.jose.jwk.gen.ECKeyGenerator;
+import com.nimbusds.jwt.JWTClaimsSet;
+import com.nimbusds.jwt.SignedJWT;
+import io.mosip.certify.core.dto.CredentialIssuerMetadataDTO;
+import io.mosip.certify.core.spi.CredentialConfigurationService;
+import io.mosip.kernel.signature.dto.JWSSignatureRequestDtoV2;
+import io.mosip.kernel.signature.dto.JWTSignatureResponseDto;
+import io.mosip.kernel.signature.service.SignatureService;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+import java.util.Base64;
+import java.nio.charset.StandardCharsets;
+import static org.mockito.Mockito.*;
+import static org.mockito.ArgumentMatchers.any;
+import static org.junit.jupiter.api.Assertions.*;
+
+class SignedIssuerMetadataServiceTest {
+    @Test void signsCurrentMetadataWithIssuerIdentityAndRequiredClaims() throws Exception {
+        var service = new SignedIssuerMetadataService();
+        var configurations = mock(CredentialConfigurationService.class);
+        var signatures = mock(SignatureService.class);
+        ReflectionTestUtils.setField(service, "configurations", configurations);
+        ReflectionTestUtils.setField(service, "signatures", signatures);
+        ReflectionTestUtils.setField(service, "mapper", new ObjectMapper());
+        ReflectionTestUtils.setField(service, "applicationId", "test-signing-app");
+        ReflectionTestUtils.setField(service, "referenceId", "test-signing-ref");
+        var metadata = new CredentialIssuerMetadataDTO();
+        metadata.setCredentialIssuer("https://issuer.example");
+        metadata.setCredentialEndpoint("https://issuer.example/credential");
+        when(configurations.fetchCredentialIssuerMetadata()).thenReturn(metadata);
+        var key = new ECKeyGenerator(Curve.P_256).generate();
+        when(signatures.jwsSignV2(any())).thenAnswer(invocation -> {
+            JWSSignatureRequestDtoV2 request = invocation.getArgument(0);
+            assertEquals("test-signing-app", request.getApplicationId());
+            assertEquals("test-signing-ref", request.getReferenceId());
+            assertEquals("ES256", request.getSignAlgorithm());
+            assertTrue(request.getIncludeCertificateChain());
+            String payload = new String(Base64.getUrlDecoder().decode(request.getDataToSign()), StandardCharsets.UTF_8);
+            SignedJWT jwt = new SignedJWT(new JWSHeader.Builder(JWSAlgorithm.ES256)
+                    .type(new JOSEObjectType((String) request.getAdditionalHeaders().get("typ")))
+                    .jwk(key.toPublicJWK()).build(), JWTClaimsSet.parse(payload));
+            jwt.sign(new ECDSASigner(key));
+            var response = new JWTSignatureResponseDto();
+            response.setJwtSignedData(jwt.serialize());
+            return response;
+        });
+        SignedJWT signed = SignedJWT.parse(service.signedMetadata());
+        assertTrue(signed.verify(new ECDSAVerifier(key.toPublicJWK())));
+        assertEquals("openidvci-issuer-metadata+jwt", signed.getHeader().getType().toString());
+        assertEquals(metadata.getCredentialIssuer(), signed.getJWTClaimsSet().getSubject());
+        assertEquals(metadata.getCredentialIssuer(), signed.getJWTClaimsSet().getIssuer());
+        assertEquals(metadata.getCredentialEndpoint(), signed.getJWTClaimsSet().getStringClaim("credential_endpoint"));
+        assertNotNull(signed.getJWTClaimsSet().getIssueTime());
+        assertTrue(signed.getJWTClaimsSet().getExpirationTime().after(signed.getJWTClaimsSet().getIssueTime()));
+        doThrow(new IllegalStateException("Signing unavailable")).when(signatures).jwsSignV2(any());
+        assertThrows(Exception.class, service::signedMetadata);
+    }
+}
