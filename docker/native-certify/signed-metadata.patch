+package io.mosip.certify.services;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.mosip.certify.core.spi.CredentialConfigurationService;
+import io.mosip.kernel.signature.dto.JWSSignatureRequestDtoV2;
+import io.mosip.kernel.signature.service.SignatureService;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Service;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Sign current issuer metadata with the configured native key-manager identity. */
+@Service
+public class SignedIssuerMetadataService {
+    @Autowired private CredentialConfigurationService configurations;
+    @Autowired private SignatureService signatures;
+    @Autowired private ObjectMapper mapper;
+    @Value("${mosip.certify.metadata.signing.application-id}") private String applicationId;
+    @Value("${mosip.certify.metadata.signing.reference-id}") private String referenceId;
+
+    public String signedMetadata() throws Exception {
+        var metadata = configurations.fetchCredentialIssuerMetadata();
+        Map<String, Object> claims = new HashMap<>(mapper.convertValue(metadata, Map.class));
+        long now = Instant.now().getEpochSecond();
+        claims.put("sub", metadata.getCredentialIssuer());
+        claims.put("iss", metadata.getCredentialIssuer());
+        claims.put("iat", now);
+        claims.put("exp", now + 300);
+        JWSSignatureRequestDtoV2 request = new JWSSignatureRequestDtoV2();
+        request.setDataToSign(Base64.getUrlEncoder().withoutPadding().encodeToString(
+                mapper.writeValueAsString(claims).getBytes(StandardCharsets.UTF_8)));
+        request.setApplicationId(applicationId);
+        request.setReferenceId(referenceId);
+        request.setSignAlgorithm("ES256");
+        request.setAdditionalHeaders(Map.of("typ", "openidvci-issuer-metadata+jwt"));
+        request.setIncludePayload(true);
+        request.setIncludeCertificateChain(true);
+        request.setIncludeCertHash(true);
+        request.setValidateJson(false);
+        request.setB64JWSHeaderParam(true);
+        request.setCertificateUrl("");
+        String signed = signatures.jwsSignV2(request).getJwtSignedData();
+        if (signed == null || signed.isBlank()) throw new IllegalStateException("Metadata signing failed");
+        return signed;
+    }
+}
