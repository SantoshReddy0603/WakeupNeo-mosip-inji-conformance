+package io.mosip.certify.filter;
+
+import com.nimbusds.jose.*;
+import com.nimbusds.jose.crypto.ECDSASigner;
+import com.nimbusds.jose.jwk.Curve;
+import com.nimbusds.jose.jwk.ECKey;
+import com.nimbusds.jose.jwk.gen.ECKeyGenerator;
+import com.nimbusds.jwt.JWTClaimsSet;
+import com.nimbusds.jwt.SignedJWT;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.time.*;
+import java.util.*;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+class DpopProofValidatorTest {
+    private static final Instant NOW = Instant.parse("2026-10-11T12:00:00Z");
+    private static final String TOKEN = "unit-access-token";
+    private static final String URI = "https://issuer.example/v1/certify/issuance/credential";
+    private ECKey key;
+    private JdbcTemplate jdbc;
+    private DpopProofValidator validator;
+    private Map<String, Object> claims;
+
+    @BeforeEach void setup() throws Exception {
+        key = new ECKeyGenerator(Curve.P_256).generate();
+        jdbc = mock(JdbcTemplate.class);
+        when(jdbc.update(anyString(), any(), any(), any())).thenReturn(1);
+        validator = new DpopProofValidator(jdbc, Clock.fixed(NOW, ZoneOffset.UTC));
+        claims = new HashMap<>();
+        claims.put("jti", UUID.randomUUID().toString());
+        claims.put("iat", NOW.getEpochSecond());
+        claims.put("htm", "POST");
+        claims.put("htu", URI);
+        claims.put("ath", Base64.getUrlEncoder().withoutPadding().encodeToString(
+                MessageDigest.getInstance("SHA-256").digest(TOKEN.getBytes(StandardCharsets.US_ASCII))));
+    }
+
+    private String proof(JWSHeader header, ECKey signer) throws Exception {
+        SignedJWT jwt = new SignedJWT(header, JWTClaimsSet.parse(claims));
+        jwt.sign(new ECDSASigner(signer));
+        return jwt.serialize();
+    }
+    private String proof() throws Exception {
+        return proof(new JWSHeader.Builder(JWSAlgorithm.ES256).type(new JOSEObjectType("dpop+jwt"))
+                .jwk(key.toPublicJWK()).build(), key);
+    }
+    private void validate(String proof) throws Exception {
+        validator.validate(proof, TOKEN, key.computeThumbprint().toString(), "POST", URI);
+    }
+    private void rejectedClaim(String name, Object value) throws Exception {
+        claims.put(name, value);
+        String proof = proof();
+        assertThrows(Exception.class, () -> validate(proof));
+        verify(jdbc, never()).update(anyString(), any(), any(), any());
+    }
+
+    @Test void validProofIsAcceptedAndRecorded() throws Exception { assertDoesNotThrow(() -> validate(proof())); }
+    @Test void wrongMethodIsRejected() throws Exception { rejectedClaim("htm", "GET"); }
+    @Test void wrongResourceIsRejected() throws Exception { rejectedClaim("htu", URI + "/other"); }
+    @Test void escapedPathIsNotDecodedAsAnotherResource() throws Exception { rejectedClaim("htu", URI.replace("/issuance/", "/issuance%2F")); }
+    @Test void wrongTokenHashIsRejected() throws Exception { rejectedClaim("ath", "wrong"); }
+    @Test void missingTokenHashIsRejected() throws Exception { rejectedClaim("ath", null); }
+    @Test void missingIdentifierIsRejected() throws Exception { rejectedClaim("jti", null); }
+    @Test void missingIssueTimeIsRejected() throws Exception { rejectedClaim("iat", null); }
+    @Test void oldProofIsRejected() throws Exception { rejectedClaim("iat", NOW.minusSeconds(301).getEpochSecond()); }
+    @Test void futureProofIsRejected() throws Exception { rejectedClaim("iat", NOW.plusSeconds(6).getEpochSecond()); }
+    @Test void userInfoInResourceIsRejected() throws Exception { rejectedClaim("htu", URI.replace("issuer.example", "attacker@issuer.example")); }
+    @Test void queryAndFragmentDoNotChangeResourceIdentity() throws Exception {
+        claims.put("htu", URI + "?x=1#fragment");
+        assertDoesNotThrow(() -> validate(proof()));
+    }
+    @Test void tokenMustBeBoundToProofKey() throws Exception {
+        String proof = proof();
+        assertThrows(Exception.class, () -> validator.validate(proof, TOKEN, "different-thumbprint", "POST", URI));
+    }
+    @Test void unboundTokenIsRejected() throws Exception {
+        String proof = proof();
+        assertThrows(Exception.class, () -> validator.validate(proof, TOKEN, null, "POST", URI));
+    }
+    @Test void wrongJwtTypeIsRejected() throws Exception {
+        String proof = proof(new JWSHeader.Builder(JWSAlgorithm.ES256).type(new JOSEObjectType("JWT"))
+                .jwk(key.toPublicJWK()).build(), key);
+        assertThrows(Exception.class, () -> validate(proof));
+    }
+    @Test void embeddedPrivateKeyIsRejected() throws Exception {
+        // Construct raw input: Nimbus also prevents creating a private JWK header.
+        String[] parts = proof().split("\\.");
+        String header = com.nimbusds.jose.util.JSONObjectUtils.toJSONString(Map.of(
+                "alg", "ES256", "typ", "dpop+jwt", "jwk", key.toJSONObject()));
+        String unsafe = com.nimbusds.jose.util.Base64URL.encode(header).toString() + "." + parts[1] + "." + parts[2];
+        assertThrows(Exception.class, () -> validate(unsafe));
+    }
+    @Test void invalidSignatureIsRejected() throws Exception {
+        String proof = proof(new JWSHeader.Builder(JWSAlgorithm.ES256).type(new JOSEObjectType("dpop+jwt"))
+                .jwk(key.toPublicJWK()).build(), new ECKeyGenerator(Curve.P_256).generate());
+        assertThrows(Exception.class, () -> validate(proof));
+    }
+    @Test void replayIsRejected() throws Exception {
+        when(jdbc.update(anyString(), any(), any(), any())).thenReturn(1, 0);
+        String proof = proof();
+        validate(proof);
+        assertThrows(Exception.class, () -> validate(proof));
+    }
+    @Test void unavailableReplayDatabaseFailsClosed() throws Exception {
+        when(jdbc.update(anyString(), any(), any(), any())).thenThrow(new IllegalStateException("database unavailable"));
+        String proof = proof();
+        assertThrows(Exception.class, () -> validate(proof));
+    }
+    @Test void missingEmbeddedKeyIsRejected() throws Exception {
+        String proof = proof(new JWSHeader.Builder(JWSAlgorithm.ES256).type(new JOSEObjectType("dpop+jwt")).build(), key);
+        assertThrows(Exception.class, () -> validate(proof));
+    }
+    @Test void unsupportedAlgorithmIsRejected() throws Exception {
+        ECKey other = new ECKeyGenerator(Curve.P_384).generate();
+        String proof = proof(new JWSHeader.Builder(JWSAlgorithm.ES384).type(new JOSEObjectType("dpop+jwt"))
+                .jwk(other.toPublicJWK()).build(), other);
+        assertThrows(Exception.class, () -> validate(proof));
+    }
+    @Test void unknownCriticalHeaderIsRejected() throws Exception {
+        String proof = proof(new JWSHeader.Builder(JWSAlgorithm.ES256).type(new JOSEObjectType("dpop+jwt"))
+                .jwk(key.toPublicJWK()).customParam("unknown", true).criticalParams(Set.of("unknown")).build(), key);
+        assertThrows(Exception.class, () -> validate(proof));
+    }
+}
