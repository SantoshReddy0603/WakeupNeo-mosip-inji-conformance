+package io.mosip.certify.filter;
+
+import com.nimbusds.jose.JWSAlgorithm;
+import com.nimbusds.jose.crypto.ECDSAVerifier;
+import com.nimbusds.jose.jwk.Curve;
+import com.nimbusds.jose.jwk.ECKey;
+import com.nimbusds.jwt.SignedJWT;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Component;
+
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.sql.Timestamp;
+import java.time.Clock;
+import java.time.Instant;
+import java.util.Base64;
+
+/** Native RFC 9449 resource proof validation with an atomic persistent replay check. */
+@Component
+public class DpopProofValidator {
+    private final JdbcTemplate jdbc;
+    private final Clock clock;
+
+    @Autowired
+    public DpopProofValidator(JdbcTemplate jdbc) {
+        this(jdbc, Clock.systemUTC());
+    }
+
+    DpopProofValidator(JdbcTemplate jdbc, Clock clock) {
+        this.jdbc = jdbc;
+        this.clock = clock;
+    }
+
+    public void validate(String proof, String accessToken, String boundThumbprint,
+                         String method, String resourceUri) throws Exception {
+        require(proof != null && proof.length() <= 16384, "Missing or oversized proof");
+        SignedJWT jwt = SignedJWT.parse(proof);
+        require(jwt.getHeader().getType() != null &&
+                "dpop+jwt".equalsIgnoreCase(jwt.getHeader().getType().toString()), "Wrong proof type");
+        require(JWSAlgorithm.ES256.equals(jwt.getHeader().getAlgorithm()), "Unsupported proof algorithm");
+        require(jwt.getHeader().getJWK() instanceof ECKey, "Proof requires an embedded public EC key");
+        ECKey key = (ECKey) jwt.getHeader().getJWK();
+        require(!key.isPrivate() && Curve.P_256.equals(key.getCurve()), "Proof key must be public P-256");
+        require(jwt.verify(new ECDSAVerifier(key)), "Invalid proof signature");
+        String thumbprint = key.computeThumbprint().toString();
+        require(boundThumbprint != null && constantEquals(thumbprint, boundThumbprint), "Access token key mismatch");
+        var claims = jwt.getJWTClaimsSet();
+        require(method.equals(claims.getStringClaim("htm")), "HTTP method mismatch");
+        require(sameResource(claims.getStringClaim("htu"), resourceUri), "Resource URI mismatch");
+        String hash = Base64.getUrlEncoder().withoutPadding().encodeToString(
+                MessageDigest.getInstance("SHA-256").digest(accessToken.getBytes(StandardCharsets.US_ASCII)));
+        require(constantEquals(hash, claims.getStringClaim("ath")), "Access token hash mismatch");
+        require(claims.getIssueTime() != null, "Missing proof issue time");
+        Instant issued = claims.getIssueTime().toInstant();
+        Instant now = clock.instant();
+        require(!issued.isBefore(now.minusSeconds(300)) && !issued.isAfter(now.plusSeconds(5)), "Proof outside time window");
+        String id = claims.getJWTID();
+        require(id != null && !id.isBlank() && id.length() <= 200, "Missing or oversized proof identifier");
+        // Expired records can be removed because their proof issue times are no longer acceptable.
+        jdbc.update("DELETE FROM certify.dpop_replay WHERE expires_at < ?", Timestamp.from(now));
+        int inserted = jdbc.update("INSERT INTO certify.dpop_replay (jkt,jti,expires_at) VALUES (?,?,?) " +
+                        "ON CONFLICT (jkt,jti) DO NOTHING", thumbprint, id, Timestamp.from(issued.plusSeconds(305)));
+        require(inserted == 1, "Replayed proof");
+    }
+
+    private static boolean constantEquals(String expected, String actual) {
+        return actual != null && MessageDigest.isEqual(expected.getBytes(StandardCharsets.US_ASCII),
+                actual.getBytes(StandardCharsets.US_ASCII));
+    }
+
+    private static boolean sameResource(String supplied, String expected) {
+        if (supplied == null) return false;
+        URI proof = URI.create(supplied).normalize();
+        URI resource = URI.create(expected).normalize();
+        if (proof.getUserInfo() != null || proof.getHost() == null || resource.getHost() == null) return false;
+        // RFC 9449 excludes query and fragment. Preserve escaped path characters.
+        return resource.getScheme().equalsIgnoreCase(proof.getScheme()) &&
+                resource.getHost().equalsIgnoreCase(proof.getHost()) &&
+                port(proof) == port(resource) && resource.getRawPath().equals(proof.getRawPath());
+    }
+
+    private static int port(URI uri) {
+        return uri.getPort() >= 0 ? uri.getPort() : "https".equalsIgnoreCase(uri.getScheme()) ? 443 : 80;
+    }
+
+    private static void require(boolean condition, String message) {
+        if (!condition) throw new IllegalArgumentException(message);
+    }
+}
