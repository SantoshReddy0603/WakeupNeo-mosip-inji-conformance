+package io.mosip.certify.core.dto;
+
+import com.fasterxml.jackson.databind.json.JsonMapper;
+import jakarta.validation.Validation;
+import jakarta.validation.ValidatorFactory;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class CredentialRequestExtensionTest {
+    private final JsonMapper mapper = JsonMapper.builder().build();
+
+    @Test
+    public void ignoresExtensionsWhilePreservingCredentialAndProof() throws Exception {
+        CredentialRequest request = mapper.readValue("""
+            {"credential_configuration_id":"course-completion-sdjwt", "proofs":{"jwt":["holder-proof"]},
+             "random_extension":{"nested":true}}
+            """, CredentialRequest.class);
+        assertEquals("course-completion-sdjwt", request.getCredentialConfigId());
+        assertEquals("holder-proof", request.getProofs().get(ProofType.JWT).getFirst());
+        try (ValidatorFactory factory = Validation.buildDefaultValidatorFactory()) {
+            assertTrue(factory.getValidator().validate(request).isEmpty());
+        }
+    }
+
+    @Test
+    public void missingRequiredCredentialAndEmptyProofAreStillInvalid() throws Exception {
+        CredentialRequest request = mapper.readValue("""
+            {"proofs":{"jwt":[]},"extension":"ignored"}
+            """, CredentialRequest.class);
+        try (ValidatorFactory factory = Validation.buildDefaultValidatorFactory()) {
+            assertFalse(factory.getValidator().validate(request).isEmpty());
+        }
+    }
+
+    @Test
+    public void unsupportedProofTypeIsStillRejected() {
+        assertThrows(Exception.class, () -> mapper.readValue("""
+            {"credential_configuration_id":"course-completion-sdjwt","proofs":{"unsupported":["proof"]}}
+            """, CredentialRequest.class));
+    }
+}
