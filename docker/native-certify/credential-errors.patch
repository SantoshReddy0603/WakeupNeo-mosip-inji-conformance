+package io.mosip.certify.core.dto;
+import com.fasterxml.jackson.databind.json.JsonMapper;
+import jakarta.validation.Validation;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class CredentialSelectorTest {
+    private boolean valid(String selector) throws Exception {
+        var request = JsonMapper.builder().build().readValue("{" + selector +
+                ",\"proofs\":{\"jwt\":[\"unit-test-proof\"]}}", CredentialRequest.class);
+        try (var factory = Validation.buildDefaultValidatorFactory()) {
+            return factory.getValidator().validate(request).isEmpty();
+        }
+    }
+    @Test public void configurationSelectorIsValid() throws Exception { assertTrue(valid("\"credential_configuration_id\":\"course\"")); }
+    @Test public void identifierSelectorIsValidForSubsequentAuthorizationChecking() throws Exception {
+        assertTrue(valid("\"credential_identifier\":\"not-authorized\""));
+    }
+    @Test public void ambiguousSelectorsAreInvalid() throws Exception {
+        assertFalse(valid("\"credential_identifier\":\"one\",\"credential_configuration_id\":\"two\""));
+    }
+    @Test public void blankOrMissingSelectorsAreInvalid() throws Exception {
+        assertFalse(valid("\"credential_identifier\":\" \""));
+        assertFalse(valid("\"extension\":true"));
+    }
+}
