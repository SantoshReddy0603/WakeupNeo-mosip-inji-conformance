diff --git a/kernel/kernel-keymanager-service/src/test/java/io/mosip/kernel/keymanager/hsm/util/CertificateSerialNumberTest.java b/kernel/kernel-keymanager-service/src/test/java/io/mosip/kernel/keymanager/hsm/util/CertificateSerialNumberTest.java
