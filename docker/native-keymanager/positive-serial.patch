@@ -0,0 +1,56 @@
+package io.mosip.kernel.keymanager.hsm.util;
+
+import io.mosip.kernel.core.keymanager.model.CertificateParameters;
+import io.mosip.kernel.keymanagerservice.dto.ExtendedCertificateParameters;
+import org.bouncycastle.jce.provider.BouncyCastleProvider;
+import org.junit.Test;
+import java.math.BigInteger;
+import java.security.KeyPairGenerator;
+import java.security.Security;
+import java.time.LocalDateTime;
+import java.util.HashSet;
+import java.util.List;
+import static org.junit.Assert.*;
+
+public class CertificateSerialNumberTest {
+    @Test public void serialsArePositiveNonzeroBoundedAndDistinct() {
+        var generated = new HashSet<BigInteger>();
+        for (int i = 0; i < 10000; i++) {
+            var serial = CertificateUtility.generateSerialNumber();
+            assertTrue(serial.signum() > 0);
+            assertTrue(serial.toByteArray().length <= 20);
+            assertTrue(generated.add(serial));
+        }
+    }
+    @Test public void ordinaryCertificatesHavePositiveSerialsAndValidSignatures() throws Exception {
+        Security.addProvider(new BouncyCastleProvider());
+        var generator = KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        var pair = generator.generateKeyPair();
+        for (int i = 0; i < 8; i++) {
+            var certificate = CertificateUtility.generateX509Certificate(pair.getPrivate(), pair.getPublic(),
+                    "development", "development", "development", "IN", LocalDateTime.now().minusMinutes(1),
+                    LocalDateTime.now().plusDays(1), "SHA256withRSA", "BC");
+            assertTrue(certificate.getSerialNumber().signum() > 0);
+            assertTrue(certificate.getSerialNumber().toByteArray().length <= 20);
+            certificate.verify(pair.getPublic());
+        }
+    }
+    @Test public void extendedCertificatesUseTheSameSafeGenerator() throws Exception {
+        Security.addProvider(new BouncyCastleProvider());
+        var generator = KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        var pair = generator.generateKeyPair();
+        var parameters = new ExtendedCertificateParameters();
+        parameters.setCommonName("development");
+        parameters.setCountry("IN");
+        parameters.setNotBefore(LocalDateTime.now().minusMinutes(1));
+        parameters.setNotAfter(LocalDateTime.now().plusDays(1));
+        parameters.setSubjectAlternativeNames(List.of());
+        var certificate = CertificateUtility.generateX509Certificate(pair.getPrivate(), pair.getPublic(),
+                parameters, null, "SHA256withRSA", "BC");
+        assertTrue(certificate.getSerialNumber().signum() > 0);
+        assertTrue(certificate.getSerialNumber().toByteArray().length <= 20);
+        certificate.verify(pair.getPublic());
+    }
+}
